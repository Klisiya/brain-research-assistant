OPENAI_API_KEY=your-api-key
SECRET_KEY=your-secret-key
FRONTEND_URL=http://127.0.0.1:5173
DATABASE_URL=sqlite:///users.db

ACCOUNT_MAIL_MODE=disabled
ACCOUNT_MAIL_FROM=
ACCOUNT_SMTP_HOST=
ACCOUNT_SMTP_PORT=587
ACCOUNT_SMTP_USER=
ACCOUNT_SMTP_PASSWORD=

APP_ENV=development
RATELIMIT_STORAGE_URI=memory://
ACCOUNT_LIMIT_LOGIN=10/minute;100/hour
ACCOUNT_LIMIT_FORGOT=5/minute;20/hour
ACCOUNT_LIMIT_RESET=10/minute;100/hour
ACCOUNT_LIMIT_ACCEPT=10/minute;100/hour
ACCOUNT_LIMIT_INVITATION=20/minute;100/hour
ACCOUNT_LIMIT_CHANGE=10/minute;100/hour
